{
  "schemaVersion": 1,
  "id": "io.github.nulluserid.dishy",
  "name": "Dishy",
  "version": "1.1.1",
  "author": "nulluserid",
  "description": "Starlink dish status in the bar with a live dashboard popup",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Dishy",
    "description": "Starlink dish status in the bar with a live dashboard popup",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "show": "latency",
      "interval": 2000,
      "autoHide": "on"
    },
    "schema": [
      {
        "key": "show",
        "type": "enum",
        "label": "Bar readout",
        "options": [
          "latency",
          "down",
          "icon"
        ],
        "defaultValue": "latency"
      },
      {
        "key": "autoHide",
        "type": "enum",
        "label": "Hide when not on Starlink",
        "description": "Widget hides itself while the machine is on another network. It reappears automatically when the dish is reachable again.",
        "options": [
          "on",
          "off"
        ],
        "defaultValue": "on"
      },
      {
        "key": "interval",
        "type": "integer",
        "label": "Bar refresh interval (ms)",
        "min": 500,
        "max": 10000,
        "step": 500,
        "defaultValue": 2000
      }
    ]
  }
}
